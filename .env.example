APP_NAME="Oscar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# System logs UI (opcodesio/log-viewer) — Settings → System logs
LOG_VIEWER_ENABLED=true

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

REQUIRE_ADMIN_TWO_FACTOR=false

# Optional kit feature flags (see docs/MODULES.md and docs/OFFLINE.md)
KIT_API=false
KIT_OFFLINE=false
KIT_AI=false
# KIT_AI_BLOCK_JAILBREAK=true
# Optional Langfuse fallbacks (Settings → AI → Tasks Observability overrides when saved)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_ENABLED=false
# LANGFUSE_LARAVEL_AI_ENABLED=true
# LANGFUSE_ENVIRONMENT=default
KIT_TRANSLATIONS_UI=true
KIT_EXPORTS=true
KIT_EXCEL_EXPORTS=true
KIT_MAIL_ALERTS=true
KIT_GOOGLE_AUTH=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# BACKUP_DISK=backups
# BACKUP_MIRROR_DISK=
# BACKUP_RETENTION_DAILY=7
# SLOW_REQUEST_MS=2000
# OFFLINE_METRICS=true
# OFFLINE_ATTACHMENTS=false

# Resumable large-file uploads (File Manager) — defaults support multi-GB files
# UPLOAD_MAX_BYTES=5368709120
# UPLOAD_CHUNK_BYTES=5242880
# UPLOAD_CONCURRENCY=3
# UPLOAD_SESSION_TTL_HOURS=48
# UPLOAD_REQUIRE_CHUNK_CHECKSUM=true
# UPLOAD_REQUIRE_FILE_CHECKSUM=false
# UPLOAD_ALLOWED_EXTENSIONS=
# UPLOAD_ALLOWED_MIMES=

VITE_APP_NAME="${APP_NAME}"
VITE_KIT_OFFLINE="${KIT_OFFLINE}"

# Oscar / ordering
FRONTEND_URL=http://localhost:3000
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=eur
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
